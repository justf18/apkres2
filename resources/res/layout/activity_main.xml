<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#f4f6f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="#1a73e8"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#d2e3fc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal Ujian CBT"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/tvWelcomeNisn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Selamat Datang, Siswa"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Pilih Kelas Ujian Hari Ini"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardKelasX"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1a73e8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ujian Kelas X"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#5f6368"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Google Form Evaluasi Pembelajaran"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1a73e8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mulai →"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardKelasXI"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1a73e8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ujian Kelas XI"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#5f6368"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Google Form Penilaian Tengah Semester"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1a73e8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mulai →"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardKelasXII"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1a73e8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ujian Kelas XII"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#5f6368"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Google Form Asesmen Sekolah"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1a73e8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mulai →"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>
