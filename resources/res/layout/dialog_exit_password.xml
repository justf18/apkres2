<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#d93025"
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Konfirmasi Keluar"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#5f6368"
        android:id="@+id/tvDialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Masukkan password keluar untuk membuka kunci aplikasi atau menghentikan alarm:"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#d93025"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="Password"/>
    <EditText
        android:textSize="15sp"
        android:id="@+id/etInputExitPassword"
        android:background="@drawable/bg_input_field"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="24dp"
        android:hint="Masukkan Password"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#5f6368"
            android:id="@+id/btnCancelExit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Batal"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            style="?attr/materialButtonOutlinedStyle"/>
        <Button
            android:textStyle="bold"
            android:id="@+id/btnUnlock"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Buka Kunci"
            android:layout_weight="1"
            android:backgroundTint="#d93025"/>
    </LinearLayout>
</LinearLayout>
